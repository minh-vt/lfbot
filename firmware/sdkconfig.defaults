CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
# PSRAM is not used. Keeping it out of the heap avoids RTOS and driver objects
# being placed in external memory, which is not safe for DMA or interrupt use.
CONFIG_SPIRAM=n
# The IDF task watchdog is disabled: it reported "task not found" from a task it
# was never told about and flooded the console. Motor safety does not rely on it;
# the I2C task coasts the motors when the control task stops renewing commands.
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_TASK_WDT_INIT=n
# The last run's log lives in its own partition (partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
